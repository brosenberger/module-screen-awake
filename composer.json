{
    "name": "brocode/module-screen-awake",
    "description": "A \"Keep screen on\" button for Magento 2 product and CMS pages: keeps the customer's phone screen awake while they follow assembly, care or installation instructions, using the browser's Screen Wake Lock API.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "homepage": "https://github.com/brosenberger/module-screen-awake",
    "keywords": [
        "magento2",
        "magento",
        "screen-wake-lock",
        "wake-lock",
        "keep-screen-on",
        "product-page",
        "ux",
        "brocode"
    ],
    "authors": [
        {
            "name": "Benjamin Rosenberger",
            "email": "bensch.rosenberger@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/brosenberger/module-screen-awake/issues",
        "source": "https://github.com/brosenberger/module-screen-awake"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/brosenberger"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": ">=103.0.0",
        "magento/module-catalog": ">=104.0.0",
        "magento/module-eav": ">=102.0.0",
        "magento/module-store": ">=101.0.0",
        "magento/module-widget": ">=101.0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BroCode\\ScreenAwake\\": ""
        }
    }
}
